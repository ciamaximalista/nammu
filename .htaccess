<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Serve WebP variants for JPEG/PNG when supported by the client.
    # Example: /assets/photo.jpg -> /assets/photo.jpg.webp (if exists)
    RewriteCond %{HTTP_ACCEPT} image/webp [NC]
    RewriteCond %{REQUEST_URI} \.(jpe?g|png)$ [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_FILENAME}.webp -f
    RewriteRule ^ %{REQUEST_URI}.webp [T=image/webp,E=serve_webp:1,L]

    # Rastreadores de reclamación de fotos y cosechadores de imágenes: 403 a todo, también a las imágenes estáticas.
    # La misma lista vive en nammu_blocked_crawler_patterns() (core/helpers.php); mantenlas iguales.
    RewriteCond %{HTTP_USER_AGENT} (tphotobot|copytrack|picrights|pixsy|imagerights|lapixa|tineye|copyright[\s_-]?agent|permission[\s_-]?machine|fairlicensing|visual[\s_-]?rights|rights[\s_-]?agent|photoclaim|imageprotect|amilabs-interleaved-research) [NC]
    RewriteRule ^ - [F,L]

    # Sondeos de vulnerabilidades de WordPress: aquí no hay WordPress.
    RewriteRule (^|/)(wp-login\.php|xmlrpc\.php|wp-admin(/.*)?|wp-content(/.*)?|wp-includes(/.*)?)$ - [F,L]

    # Friendly URLs and machine-readable files delegated to the front controller.
    RewriteRule ^rss\.xml$ index.php [L]
    RewriteRule ^blog\.xml$ index.php [L]
    RewriteRule ^sitemap\.xml$ index.php [L]
    RewriteRule ^podcast\.xml$ index.php [L]
    RewriteRule ^llms\.txt$ index.php [L]
    RewriteRule ^llms-posts\.txt$ index.php [L]
    RewriteRule ^llms-full\.txt$ index.php [L]
    RewriteRule ^identity\.txt$ index.php [L]
    RewriteRule ^robots\.txt$ index.php [L]
    RewriteRule ^\.well-known/tdmrep\.json$ index.php [L]
    RewriteRule ^itinerarios\.xml$ index.php [L]
    RewriteRule ^noticias\.xml$ index.php [L]
    RewriteRule ^itinerarios(/.*)?$ index.php [L]
    RewriteRule ^avisos/?$ avisos.php [L]
    RewriteRule ^correos/?$ correos.php [L]

    # Deny access to internal dirs and files by passing the URL to Pico
    RewriteRule ^(config|content|core|template|vendor|CHANGELOG\.md|composer\.(json|lock|phar))(/|$) index.php [L]
    RewriteRule (^\.|/\.)(?!well-known(/|sitemap\.xml$)) index.php [L]

    # Enable URL rewriting
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]

    <IfModule mod_env.c>
        # Let Pico know about available URL rewriting
        SetEnv PICO_URL_REWRITING 1
    </IfModule>
</IfModule>

# Prevent file browsing
Options -Indexes -MultiViews

# Compresión de texto: menos bytes para rastreadores y lectores.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/markdown text/css text/javascript application/javascript application/json application/ld+json application/xml application/rss+xml application/activity+json application/jrd+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    Header append Vary Accept env=serve_webp
    # Los XML y TXT (feeds, sitemap, robots, llms) cambian a menudo: no deben quedar un mes en caché.
    <FilesMatch "\.(?:css|js|mjs|json|svg|ico|gif|jpe?g|png|webp|avif|mp4|webm|ogv|mp3|wav|m4a|flac|pdf|woff2?|ttf|otf)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
    <FilesMatch "\.(?:xml|txt)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/json "access plus 1 month"
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType application/rss+xml "access plus 1 hour"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType video/mp4 "access plus 1 month"
    ExpiresByType video/webm "access plus 1 month"
    ExpiresByType video/ogg "access plus 1 month"
    ExpiresByType audio/mpeg "access plus 1 month"
    ExpiresByType audio/mp4 "access plus 1 month"
    ExpiresByType audio/ogg "access plus 1 month"
    ExpiresByType audio/flac "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType font/woff "access plus 1 month"
    ExpiresByType font/ttf "access plus 1 month"
    ExpiresByType font/otf "access plus 1 month"
</IfModule>
